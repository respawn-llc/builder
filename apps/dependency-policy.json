{
  "$schema": "./dependency-policy.schema.json",
  "minimumReleaseAgeMinutes": 10080,
  "minimumReleaseAgeExclude": [
    "@napi-rs/wasm-runtime@1.2.2",
    "vite@8.2.0"
  ],
  "directDependencyAllowlist": {
    "@app/apps": {
      "devDependencies": ["postcss", "prettier"]
    },
    "@app/desktop": {
      "dependencies": [
        "@app/native-bridge",
        "@app/server-api-contract",
        "@app/ui-kit",
        "@fontsource-variable/montserrat",
        "@hookform/resolvers",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-radio-group",
        "@radix-ui/react-switch",
        "@radix-ui/react-tooltip",
        "@tanstack/react-query",
        "@tanstack/react-router",
        "@tanstack/react-virtual",
        "@tauri-apps/api",
        "@xyflow/react",
        "clsx",
        "elkjs",
        "i18next",
        "lucide-react",
        "react",
        "react-dom",
        "react-hook-form",
        "react-i18next",
        "remark-breaks",
        "remark-gfm",
        "remark-parse",
        "shiki",
        "shadcn",
        "sonner",
        "streamdown",
        "tailwind-merge",
        "tw-animate-css",
        "unified",
        "zod"
      ],
      "devDependencies": [
        "@eslint/js",
        "@tailwindcss/vite",
        "@tauri-apps/cli",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event",
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-boundaries",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "eslint-plugin-testing-library",
        "jsdom",
        "tailwindcss",
        "typescript",
        "typescript-eslint",
        "typescript7",
        "vite",
        "vitest"
      ]
    },
    "@app/native-bridge": {
      "dependencies": [
        "@tauri-apps/api",
        "@tauri-apps/plugin-clipboard-manager",
        "@tauri-apps/plugin-notification",
        "@tauri-apps/plugin-process",
        "@tauri-apps/plugin-store",
        "@tauri-apps/plugin-updater",
        "zod"
      ],
      "devDependencies": ["typescript", "typescript7", "vitest"]
    },
    "@app/server-api-contract": {
      "dependencies": ["@bufbuild/protobuf", "@bufbuild/protovalidate"],
      "devDependencies": ["typescript", "typescript7"]
    },
    "@app/ui-kit": {
      "dependencies": ["@dnd-kit/core", "@dnd-kit/sortable", "react"],
      "devDependencies": [
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@types/react",
        "@types/react-dom",
        "typescript",
        "typescript7",
        "vitest"
      ]
    }
  }
}
