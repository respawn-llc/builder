{
  "name": "@app/server-api-contract",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "import": "./dist/gen/*.js"
    }
  },
  "scripts": {
    "build": "go run github.com/go-task/task/v3/cmd/task@v3.52.0 --dir ../../../.. --temp-dir .generated/protobuf/task protobuf:ts && node ./node_modules/typescript7/bin/tsc -b --pretty false",
    "typecheck": "go run github.com/go-task/task/v3/cmd/task@v3.52.0 --dir ../../../.. --temp-dir .generated/protobuf/task protobuf:ts && node ./node_modules/typescript7/bin/tsc -b --pretty false"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
