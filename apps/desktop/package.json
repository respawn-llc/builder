{
  "name": "@app/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config tooling/vite.config.ts --host 127.0.0.1",
    "dev:browser": "vite --config tooling/vite.config.ts --host 127.0.0.1 --open /",
    "build": "pnpm build:web",
    "build:web": "node ./node_modules/typescript7/bin/tsc -b --pretty false && vite --config tooling/vite.config.ts build && node ../scripts/check-desktop-font-assets.mjs",
    "preview": "vite --config tooling/vite.config.ts preview",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -b --pretty false",
    "test": "vitest --config tooling/vite.config.ts run",
    "test:watch": "vitest --config tooling/vite.config.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "../../scripts/build-desktop.sh --skip-install",
    "tauri:install": "../../scripts/build-desktop.sh --install"
  },
  "dependencies": {
    "@app/native-bridge": "workspace:*",
    "@app/ui-kit": "workspace:*",
    "@fontsource-variable/montserrat": "5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shadcn": "^4.16.0",
    "shiki": "4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
