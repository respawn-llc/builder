{
  "name": "@app/apps",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps:policy": "node ./scripts/check-dependency-policy.mjs",
    "desktop:dev": "pnpm --filter @app/desktop tauri:dev",
    "desktop:dev:browser": "pnpm --filter @app/desktop dev:browser",
    "desktop:build": "pnpm --filter @app/desktop tauri:build",
    "desktop:install": "pnpm --filter @app/desktop tauri:install",
    "architecture:policy": "node --test ./scripts/check-eslint-architecture.test.mjs",
    "lint": "pnpm deps:policy && pnpm ts:policy && pnpm architecture:policy && pnpm --recursive --if-present lint",
    "ts:policy": "node ./scripts/check-typescript-policy.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm deps:policy && pnpm ts:policy && pnpm architecture:policy && pnpm --recursive --if-present test",
    "format": "pnpm --recursive --if-present format",
    "build": "pnpm deps:policy && pnpm ts:policy && pnpm --recursive --if-present build"
  },
  "devDependencies": {
    "postcss": "8.5.26",
    "prettier": "^3.9.6"
  }
}
