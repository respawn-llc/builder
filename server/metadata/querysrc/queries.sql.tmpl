{{define "workflowSessionDependencyInvalidation"}}
UPDATE session_workflow_node_associations
SET association_status = 'historical'
WHERE task_id = ?1
  AND association_status = 'current'
  AND (?4 IS NULL OR transition_branch_key = ?4)
  AND session_id IN (
      WITH RECURSIVE dependent_sessions(session_id) AS (
          SELECT association.session_id
          FROM session_workflow_node_associations association
          WHERE association.task_id = ?1
            AND association.association_status = 'current'
            AND association.source_session_id = ?2
            AND association.session_id != ?3
            AND (?4 IS NULL OR association.transition_branch_key = ?4)
          UNION
          SELECT association.session_id
          FROM session_workflow_node_associations association
          JOIN dependent_sessions dependency
            ON association.source_session_id = dependency.session_id
          WHERE association.task_id = ?1
            AND association.association_status = 'current'
            AND association.session_id != ?3
            AND (?4 IS NULL OR association.transition_branch_key = ?4)
      )
      SELECT session_id
      FROM dependent_sessions
  );
{{end}}

{{define "taskSearchSchemaContract"}}
WITH
required_objects(object_kind, object_name, owner_name) AS (
    VALUES
        ('table', 'task_search_documents', 'task_search_documents'),
        ('table', 'task_search_fts', 'task_search_fts'),
        ('table', 'task_search_short_id_fts', 'task_search_short_id_fts'),
        ('view', 'task_search_content', 'task_search_content'),
        ('index', 'task_search_documents_task_short_id_unique', 'task_search_documents'),
        ('index', 'task_search_documents_task_title_unique', 'task_search_documents'),
        ('index', 'task_search_documents_task_body_unique', 'task_search_documents'),
        ('index', 'task_search_documents_comment_unique', 'task_search_documents'),
        ('trigger', 'task_search_short_id_document_insert', 'task_search_documents'),
        ('trigger', 'task_search_short_id_document_delete', 'task_search_documents'),
        ('trigger', 'task_search_text_document_insert', 'task_search_documents'),
        ('trigger', 'task_search_text_document_delete', 'task_search_documents'),
        ('trigger', 'task_search_task_insert', 'tasks'),
        ('trigger', 'task_search_comment_insert', 'task_comments'),
        ('trigger', 'task_search_task_title_before_update', 'tasks'),
        ('trigger', 'task_search_task_title_after_update', 'tasks'),
        ('trigger', 'task_search_task_body_before_update', 'tasks'),
        ('trigger', 'task_search_task_body_after_update', 'tasks'),
        ('trigger', 'task_search_comment_body_before_update', 'task_comments'),
        ('trigger', 'task_search_comment_body_after_update', 'task_comments'),
        ('trigger', 'task_search_comment_delete', 'task_comments'),
        ('trigger', 'task_search_task_delete', 'tasks')
),
object_contract_failures AS (
    SELECT 'objects' AS failure
    WHERE EXISTS (
        SELECT 1
        FROM required_objects required
        LEFT JOIN sqlite_schema actual
          ON actual.type = required.object_kind
         AND actual.name = required.object_name
         AND actual.tbl_name = required.owner_name
        WHERE actual.name IS NULL
    )
),
expected_mapping_columns(position, column_name, column_type, not_null, primary_key) AS (
    VALUES
        (0, 'document_id', 'INTEGER', 0, 1),
        (1, 'source_kind', 'TEXT', 1, 0),
        (2, 'task_id', 'TEXT', 0, 0),
        (3, 'comment_id', 'TEXT', 0, 0)
),
mapping_columns AS (
    SELECT cid AS position, name AS column_name, type AS column_type, "notnull" AS not_null, pk AS primary_key
    FROM pragma_table_info('task_search_documents')
),
mapping_column_contract_failures AS (
    SELECT 'mapping_columns' AS failure
    WHERE (SELECT COUNT(*) FROM mapping_columns) != 4
       OR EXISTS (
            SELECT position, column_name, column_type, not_null, primary_key
            FROM expected_mapping_columns
            EXCEPT
            SELECT position, column_name, column_type, not_null, primary_key
            FROM mapping_columns
       )
       OR EXISTS (
            SELECT position, column_name, column_type, not_null, primary_key
            FROM mapping_columns
            EXCEPT
            SELECT position, column_name, column_type, not_null, primary_key
            FROM expected_mapping_columns
       )
),
expected_mapping_foreign_keys(parent_table, child_column, parent_column, on_delete) AS (
    VALUES
        ('tasks', 'task_id', 'id', 'CASCADE'),
        ('task_comments', 'comment_id', 'id', 'CASCADE')
),
mapping_foreign_keys AS (
    SELECT "table" AS parent_table, "from" AS child_column, "to" AS parent_column, on_delete
    FROM pragma_foreign_key_list('task_search_documents')
),
mapping_foreign_key_contract_failures AS (
    SELECT 'mapping_foreign_keys' AS failure
    WHERE (SELECT COUNT(*) FROM mapping_foreign_keys) != 2
       OR EXISTS (
            SELECT parent_table, child_column, parent_column, on_delete
            FROM expected_mapping_foreign_keys
            EXCEPT
            SELECT parent_table, child_column, parent_column, on_delete
            FROM mapping_foreign_keys
       )
       OR EXISTS (
            SELECT parent_table, child_column, parent_column, on_delete
            FROM mapping_foreign_keys
            EXCEPT
            SELECT parent_table, child_column, parent_column, on_delete
            FROM expected_mapping_foreign_keys
       )
),
expected_mapping_indexes(index_name, column_name) AS (
    VALUES
        ('task_search_documents_task_short_id_unique', 'task_id'),
        ('task_search_documents_task_title_unique', 'task_id'),
        ('task_search_documents_task_body_unique', 'task_id'),
        ('task_search_documents_comment_unique', 'comment_id')
),
mapping_indexes AS (
    SELECT index_list.name AS index_name, index_list."unique" AS is_unique, index_list.partial AS is_partial
    FROM pragma_index_list('task_search_documents') index_list
),
mapping_index_columns AS (
    SELECT index_list.name AS index_name, index_columns.name AS column_name
    FROM pragma_index_list('task_search_documents') index_list
    JOIN pragma_index_xinfo(index_list.name) index_columns
      ON index_columns.key = 1
),
mapping_index_contract_failures AS (
    SELECT 'mapping_indexes' AS failure
    WHERE (SELECT COUNT(*) FROM mapping_indexes) != 4
       OR EXISTS (
            SELECT 1
            FROM mapping_indexes
            WHERE is_unique != 1
               OR is_partial != 1
       )
       OR EXISTS (
            SELECT index_name, column_name
            FROM expected_mapping_indexes
            EXCEPT
            SELECT index_name, column_name
            FROM mapping_index_columns
       )
       OR EXISTS (
            SELECT index_name, column_name
            FROM mapping_index_columns
            EXCEPT
            SELECT index_name, column_name
            FROM expected_mapping_indexes
       )
),
expected_fts_columns(position, column_name, hidden) AS (
    VALUES
        (0, 'title', 0),
        (1, 'body', 0),
        (2, 'comment', 0),
        (3, 'task_search_fts', 1),
        (4, 'rank', 1)
),
fts_columns AS (
    SELECT cid AS position, name AS column_name, hidden
    FROM pragma_table_xinfo('task_search_fts')
),
fts_virtual_table_contract_failures AS (
    SELECT 'fts_table' AS failure
    WHERE (SELECT type FROM pragma_table_list WHERE schema = 'main' AND name = 'task_search_fts') != 'virtual'
       OR (SELECT COUNT(*) FROM fts_columns) != 5
       OR EXISTS (
            SELECT position, column_name, hidden
            FROM expected_fts_columns
            EXCEPT
            SELECT position, column_name, hidden
            FROM fts_columns
       )
       OR EXISTS (
            SELECT position, column_name, hidden
            FROM fts_columns
            EXCEPT
            SELECT position, column_name, hidden
            FROM expected_fts_columns
       )
),
expected_short_id_fts_columns(position, column_name, hidden) AS (
    VALUES
        (0, 'short_id', 0),
        (1, 'task_search_short_id_fts', 1),
        (2, 'rank', 1)
),
short_id_fts_columns AS (
    SELECT cid AS position, name AS column_name, hidden
    FROM pragma_table_xinfo('task_search_short_id_fts')
),
short_id_fts_virtual_table_contract_failures AS (
    SELECT 'short_id_fts_table' AS failure
    WHERE (SELECT type FROM pragma_table_list WHERE schema = 'main' AND name = 'task_search_short_id_fts') != 'virtual'
       OR (SELECT COUNT(*) FROM short_id_fts_columns) != 3
       OR EXISTS (
            SELECT position, column_name, hidden
            FROM expected_short_id_fts_columns
            EXCEPT
            SELECT position, column_name, hidden
            FROM short_id_fts_columns
       )
       OR EXISTS (
            SELECT position, column_name, hidden
            FROM short_id_fts_columns
            EXCEPT
            SELECT position, column_name, hidden
            FROM expected_short_id_fts_columns
       )
)
SELECT failure FROM object_contract_failures
UNION ALL
SELECT failure FROM mapping_column_contract_failures
UNION ALL
SELECT failure FROM mapping_foreign_key_contract_failures
UNION ALL
SELECT failure FROM mapping_index_contract_failures
UNION ALL
SELECT failure FROM fts_virtual_table_contract_failures
UNION ALL
SELECT failure FROM short_id_fts_virtual_table_contract_failures
ORDER BY failure ASC;
{{end}}

{{define "taskSearchPageDescriptors"}}
WITH RECURSIVE
args AS (
    SELECT
        CAST(?1 AS TEXT) AS mode,
        CAST(?2 AS TEXT) AS candidate_expression,
        CAST(?3 AS TEXT) AS literal_query,
        CAST(?4 AS INTEGER) AS case_mode,
        CAST(?5 AS INTEGER) AS include_comments,
        CAST(?6 AS TEXT) AS project_ids_json,
        CAST(?7 AS TEXT) AS status_kinds_json,
        CAST(?8 AS INTEGER) AS context_clusters,
        CAST(?9 AS INTEGER) AS offset_rows,
        CAST(?10 AS INTEGER) AS limit_rows,
        CAST(?11 AS TEXT) AS live_task_states_json,
        CAST(?12 AS INTEGER) AS short_id_case_mode
),
literal_args AS (
    SELECT *
    FROM args
    WHERE mode = 'literal'
),
{{taskStatusProjection "" "(SELECT live_task_states_json FROM args)" ","}}
matching_sources AS (
    SELECT
        task.id AS task_id,
        task.project_id,
        project.project_key,
        task.short_id,
        task.workflow_id,
        task.title AS task_title,
        status.is_done,
        status.kind AS status_kind,
        status.node_ids_json,
        status.attention_types_json,
        document.document_id,
        document.source_kind,
        document.comment_id,
        NULL AS comment_created_at_unix_ms,
        CAST(
            CASE
                WHEN task.short_id = args.literal_query COLLATE NOCASE
                  OR CAST(task.task_seq AS TEXT) = args.literal_query
                    THEN 0
                ELSE 1
            END
            AS INTEGER
        ) AS match_class,
        CAST(0.0 AS REAL) AS weighted_rank,
        CAST(1 AS INTEGER) AS source_hit_count,
        NULL AS raw_snippet
    FROM literal_args args
    CROSS JOIN task_search_short_id_fts
    JOIN task_search_documents document
      ON document.document_id = task_search_short_id_fts.rowid
    JOIN task_records task
      ON task.id = document.task_id
    JOIN projects project
      ON project.id = task.project_id
    JOIN task_search_content content
      ON content.document_id = document.document_id
    JOIN effective_status status
      ON status.task_id = task.id
    WHERE task_search_short_id_fts MATCH ?2
      AND (
          args.project_ids_json IS NULL
          OR task.project_id IN (
              SELECT CAST(value AS TEXT)
              FROM json_each(args.project_ids_json)
          )
      )
      AND (
          args.status_kinds_json IS NULL
          OR status.kind IN (
              SELECT CAST(value AS TEXT)
              FROM json_each(args.status_kinds_json)
          )
      )
      AND kent_task_search_occurrence_count_v1(
          content.short_id,
          args.literal_query,
          args.short_id_case_mode
      ) > 0
    UNION ALL
    SELECT
        task.id AS task_id,
        task.project_id,
        project.project_key,
        task.short_id,
        task.workflow_id,
        task.title AS task_title,
        status.is_done,
        status.kind AS status_kind,
        status.node_ids_json,
        status.attention_types_json,
        document.document_id,
        document.source_kind,
        document.comment_id,
        CASE document.source_kind
            WHEN 'comment' THEN comment.created_at_unix_ms
            ELSE NULL
        END AS comment_created_at_unix_ms,
        CAST(2 AS INTEGER) AS match_class,
        CAST(
            -task_search_fts.rank * CASE document.source_kind
                WHEN 'title' THEN 10.0
                WHEN 'body' THEN 1.0
                ELSE 0.75
            END
            AS REAL
        ) AS weighted_rank,
        CAST(
            CASE args.mode
                WHEN 'literal' THEN kent_task_search_occurrence_count_v1(
                    COALESCE(content.title, content.body, content.comment),
                    args.literal_query,
                    args.case_mode
                )
                WHEN 'fts5' THEN 1
            END
            AS INTEGER
        ) AS source_hit_count,
        CASE args.mode
            WHEN 'fts5' THEN snippet(
                task_search_fts,
                CASE document.source_kind
                    WHEN 'title' THEN 0
                    WHEN 'body' THEN 1
                    WHEN 'comment' THEN 2
                END,
                '',
                '',
                '',
                args.context_clusters
            )
        END AS raw_snippet
    FROM task_search_fts
    CROSS JOIN args
    JOIN task_search_documents document
      ON document.document_id = task_search_fts.rowid
    LEFT JOIN task_comments comment
      ON comment.id = document.comment_id
    JOIN task_records task
      ON task.id = COALESCE(document.task_id, comment.task_id)
    JOIN projects project
      ON project.id = task.project_id
    JOIN task_search_content content
      ON content.document_id = document.document_id
    JOIN effective_status status
      ON status.task_id = task.id
    WHERE task_search_fts MATCH ?2
      AND (args.include_comments != 0 OR document.source_kind != 'comment')
      AND (
          args.project_ids_json IS NULL
          OR task.project_id IN (
              SELECT CAST(value AS TEXT)
              FROM json_each(args.project_ids_json)
          )
      )
      AND (
          args.status_kinds_json IS NULL
          OR status.kind IN (
              SELECT CAST(value AS TEXT)
              FROM json_each(args.status_kinds_json)
          )
      )
      AND (
          args.mode = 'fts5'
          OR kent_task_search_occurrence_count_v1(
              COALESCE(content.title, content.body, content.comment),
              args.literal_query,
              args.case_mode
          ) > 0
      )
),
ranked_sources AS (
    SELECT
        matching_sources.*,
        CAST(MIN(match_class) OVER (
            PARTITION BY task_id
        ) AS INTEGER) AS task_match_class,
        CAST(MAX(weighted_rank) OVER (
            PARTITION BY task_id
        ) AS REAL) AS task_weighted_rank,
        CAST(SUM(source_hit_count) OVER (
            PARTITION BY task_id
        ) AS INTEGER) AS total_hit_count,
        CAST(COALESCE(SUM(source_hit_count) OVER (
            PARTITION BY task_id
            ORDER BY
                CASE source_kind
                    WHEN 'short_id' THEN 0
                    WHEN 'title' THEN 1
                    WHEN 'body' THEN 2
                    WHEN 'comment' THEN 3
                END ASC,
                CASE source_kind
                    WHEN 'comment' THEN weighted_rank
                END DESC,
                comment_created_at_unix_ms DESC,
                comment_id DESC,
                document_id ASC
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
        ), 0) AS INTEGER) AS source_ordinal_before
    FROM matching_sources
),
task_hits AS (
    SELECT
        task_id,
        MAX(total_hit_count) AS total_hit_count
    FROM ranked_sources
    GROUP BY task_id
),
hit_count_buckets AS (
    SELECT
        total_hit_count,
        COUNT(*) AS task_count
    FROM task_hits
    GROUP BY total_hit_count
),
round_intervals AS (
    SELECT
        COALESCE(LAG(total_hit_count) OVER (
            ORDER BY total_hit_count ASC
        ), 0) + 1 AS first_ordinal,
        total_hit_count AS last_ordinal,
        CAST(
            COALESCE(SUM(total_hit_count * task_count) OVER (
                ORDER BY total_hit_count ASC
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            ), 0)
            + COALESCE(LAG(total_hit_count) OVER (
                ORDER BY total_hit_count ASC
            ), 0) * SUM(task_count) OVER (
                ORDER BY total_hit_count ASC
                ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING
            )
            AS INTEGER
        ) AS rows_before,
        CAST(SUM(task_count) OVER (
            ORDER BY total_hit_count ASC
            ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING
        ) AS INTEGER) AS rows_per_round
    FROM hit_count_buckets
),
page_window AS (
    SELECT
        capacities.first_ordinal + CAST(
            (args.offset_rows - capacities.rows_before) / capacities.rows_per_round
            AS INTEGER
        ) AS first_ordinal,
        CAST(
            (args.offset_rows - capacities.rows_before) % capacities.rows_per_round
            AS INTEGER
        ) AS first_round_offset,
        args.limit_rows
    FROM round_intervals capacities
    CROSS JOIN args
    WHERE args.limit_rows > 0
      AND args.offset_rows >= capacities.rows_before
      AND args.offset_rows < capacities.rows_before
          + (capacities.last_ordinal - capacities.first_ordinal + 1) * capacities.rows_per_round
    ORDER BY capacities.first_ordinal ASC
    LIMIT 1
),
rounds AS (
    SELECT
        page_window.first_ordinal AS ordinal
    FROM page_window
    UNION ALL
    SELECT
        rounds.ordinal + 1
    FROM rounds
    CROSS JOIN page_window
    WHERE rounds.ordinal - page_window.first_ordinal + 1 < page_window.limit_rows
)
SELECT
    ranked_sources.task_id,
    ranked_sources.project_id,
    ranked_sources.project_key,
    ranked_sources.short_id,
    ranked_sources.workflow_id,
    ranked_sources.task_title,
    ranked_sources.is_done,
    ranked_sources.status_kind,
    ranked_sources.node_ids_json,
    ranked_sources.attention_types_json,
    ranked_sources.document_id,
    ranked_sources.source_kind,
    ranked_sources.comment_id,
    ranked_sources.total_hit_count,
    CAST(rounds.ordinal AS INTEGER) AS ordinal,
    CAST(rounds.ordinal - ranked_sources.source_ordinal_before AS INTEGER) AS source_ordinal,
    ranked_sources.task_weighted_rank,
    ranked_sources.raw_snippet
FROM rounds
JOIN ranked_sources
  ON rounds.ordinal > ranked_sources.source_ordinal_before
 AND rounds.ordinal <= ranked_sources.source_ordinal_before + ranked_sources.source_hit_count
CROSS JOIN args
ORDER BY
    rounds.ordinal ASC,
    ranked_sources.task_match_class ASC,
    CASE ranked_sources.task_match_class
        WHEN 2 THEN ranked_sources.task_weighted_rank
        ELSE 0.0
    END DESC,
    ranked_sources.task_id ASC
LIMIT (SELECT limit_rows FROM args)
OFFSET COALESCE((SELECT first_round_offset FROM page_window), 0);
{{end}}
{{if .IncludeTaskSearchPageDescriptors}}{{template "taskSearchPageDescriptors" .}}{{end}}
