-- name: ListIdleWorkflowTaskSessions :many
{{template "taskSessionProjectionFields" .}}
FROM sessions session INDEXED BY sessions_task_activity_idx
{{template "taskSessionProjectionJoins" .}}
WHERE session.task_id = sqlc.arg(task_id)
  AND NOT EXISTS (
      SELECT 1
      FROM json_each(CAST(sqlc.arg(excluded_session_ids_json) AS TEXT)) excluded
