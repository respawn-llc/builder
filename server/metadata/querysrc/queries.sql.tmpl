-- name: CountTaskNodeReferences :one
SELECT CAST(COUNT(*) AS INTEGER) AS ref_count
FROM (
    SELECT current_node.task_id
    FROM task_current_nodes current_node
    WHERE current_node.node_id = kent_graph_entity_id_blob_v1(CAST(sqlc.arg(node_id) AS TEXT))
    UNION ALL
    SELECT approval.id
    FROM task_pending_approvals approval
    WHERE approval.source_node_id = kent_graph_entity_id_blob_v1(CAST(sqlc.arg(node_id) AS TEXT))
    UNION ALL
    SELECT branch.approval_id
    FROM task_pending_approval_branches branch
    WHERE kent_graph_entity_id_blob_v1(
        json_extract(branch.target_snapshot_json, '$.node_id')
    ) = kent_graph_entity_id_blob_v1(CAST(sqlc.arg(node_id) AS TEXT))
);

